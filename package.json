{
  "name": "nss-towels-erp",
  "productName": "NSS-TEX ERP",
  "version": "1.0.0",
  "private": true,
  "description": "NSS TOWELS / TexMan ERP Manufacturing Management Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node backend/server.js",
    "dev:backend": "node backend/server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "db:clear": "node scripts/clearDatabase.js",
    "desktop": "concurrently \"npm run server\" \"electron .\"",
    "desktop:dev": "concurrently \"npm run dev\" \"npm run server\" \"electron .\"",
    "electron": "electron .",
    "electron:dev": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "start": "electron ."
  },
  "build": {
    "appId": "com.nsstowels.erp",
    "productName": "NSS-TEX ERP",
    "copyright": "Copyright © 2026 NSS TOWELS",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NSS-TEX ERP"
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.1"
  }
}
